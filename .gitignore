# =================================================================
# Roadzen-View Master Gitignore
# =================================================================

# --- System Files ---
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# --- Dependencies (Node & Bun) ---
node_modules/
.npm
.eslintcache
bun.lockb
*.log

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/

# --- YOLO / Machine Learning Artifacts ---
# This ignores the heavy training runs and weight files
runs/
weights/
*.pt
*.onnx
*.engine
*.cache
*.mlmodel
*.tflite

# --- Large Media & Datasets ---
# Prevents video files and datasets from bloating the repo
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar.gz
*.rar

# --- Backend / Environment Secrets ---
# NEVER commit your actual secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.stackery

# --- Frontend / Build Output ---
dist/
tmp/
out/
.vercel
.turbo

# --- Database ---
*.sqlite
*.db